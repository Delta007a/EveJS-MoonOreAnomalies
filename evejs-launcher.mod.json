{
  "schemaVersion": 3,
  "id": "moonoreanomalies",
  "displayName": "MoonOreAnomalies",
  "version": "0.5.3",
  "description": "Server-side Moon Ore anomaly families and dungeon/scanner integration.",
  "kind": "loader",
  "supportedBackends": [
    "native"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "0.12.8",
      "0.12.9",
      "261028.1"
    ]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [
      {
        "id": "preferences",
        "base": "mod",
        "path": "settings.json",
        "format": "json"
      }
    ],
    "fields": [
      {
        "id": "enabled",
        "label": "Enable Moon Ore anomalies",
        "type": "boolean",
        "default": false,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "enabled"
        ]
      },
      {
        "id": "verbose",
        "label": "Verbose logging",
        "type": "boolean",
        "default": false,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "verbose"
        ],
        "advanced": true
      }
    ]
  },
  "updates": {
    "provider": "github",
    "repository": "Delta007a/EveJS-MoonOreAnomalies",
    "asset": "EveJS-MoonOreAnomalies-{version}.zip",
    "channel": "stable",
    "tagPrefix": "v",
    "preserveFiles": []
  },
  "loadBefore": [
    "soloprogressionbalance",
    "droneclassbalance"
  ],
  "launcherApi": {
    "version": 1,
    "minLauncherVersion": "1.0.74",
    "helper": {
      "runtime": "node",
      "path": "helper.js"
    },
    "capabilities": [
      "prepare_server_start",
      "verify"
    ]
  }
}
