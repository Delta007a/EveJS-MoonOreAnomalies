# Opt in to Moon anomaly creation. Default: 0.
# To uninstall safely, keep the loader enabled, set this to 0, restart once,
# and wait for the "retirement success" log before removing the loader/folder.
EVEJS_MOON_ORE_ANOMALIES=0

# Logs hook-time family and retirement details. Default: 0.
EVEJS_MOON_ORE_ANOMALIES_VERBOSE=0

# Relative to the per-family/security-band probabilities in moonOreSiteRules.json.
EVEJS_MOON_SPAWN_CHANCE_MULTIPLIER=1
# 0 keeps the legacy uncapped family distribution.
EVEJS_MOON_MAX_SITES_PER_SYSTEM=0
# Starts at full depletion; replacement also waits for the old grid to empty.
EVEJS_MOON_RESPAWN_DELAY_MINUTES=0
